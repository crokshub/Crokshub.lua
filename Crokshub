local function CriarOtimizacao(nome, desc, onFunction, offFunction)
    local Panel = Instance.new("Frame")
    Panel.Size = UDim2.new(1, -10, 0, 60)
    Panel.Position = UDim2.new(0, 5, 0, yPos2)
    Panel.BackgroundColor3 = CorPainel
    Panel.BorderSizePixel = 0
    Panel.Parent = Tab2Content
    
    local PanelCorner = Instance.new("UICorner")
    PanelCorner.CornerRadius = UDim.new(0, 8)
    PanelCorner.Parent = Panel
    
    local PanelStroke = Instance.new("UIStroke")
    PanelStroke.Thickness = 1
    PanelStroke.Color = Color3.fromRGB(30, 30, 35)
    PanelStroke.Parent = Panel
    
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -50, 0, 25)
    Title.Position = UDim2.new(0, 10, 0, 5)
    Title.Text = nome
    Title.TextColor3 = CorTexto
    Title.TextSize = 14
    Title.Font = Enum.Font.GothamBold
    Title.BackgroundTransparency = 1
    Title.Parent = Panel
    
    local Desc = Instance.new("TextLabel")
    Desc.Size = UDim2.new(1, -50, 0, 15)
    Desc.Position = UDim2.new(0, 10, 0, 30)
    Desc.Text = desc
    Desc.TextColor3 = CorCinza
    Desc.TextSize = 10
    Desc.Font = Enum.Font.Gotham
    Desc.BackgroundTransparency = 1
    Desc.Parent = Panel
    
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(0, 40, 0, 25)
    ToggleBtn.Position = UDim2.new(1, -50, 0, 17)
    ToggleBtn.Text = "ON"
    ToggleBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
    ToggleBtn.TextSize = 10
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.BackgroundColor3 = CorBorda
    ToggleBtn.Parent = Panel
    
    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(1, 0)
    ToggleCorner.Parent = ToggleBtn
    
    local isOn = true
    ToggleBtn.MouseButton1Click:Connect(function()
        isOn = not isOn
        if isOn then
            ToggleBtn.Text = "ON"
            ToggleBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
            ToggleBtn.BackgroundColor3 = CorBorda
            onFunction()
        else
            ToggleBtn.Text = "OFF"
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            offFunction()
        end
    end)
    
    yPos2 = yPos2 + 70
end

