    hue = (hue + 0.002) % 1
    
    local r, g, b = Color3.fromHSV(hue, 1, 1):ToRGB()
    
    UIStroke.Color = Color3.fromRGB(r, g, b)
    MenuStroke.Color = Color3.fromRGB(r, g, b)
    Title.TextColor3 = Color3.fromRGB(r, g, b)
end)

print("✅ Croks Hub Clean Edition (Bola Redonda) carregado!")
