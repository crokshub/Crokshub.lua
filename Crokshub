-- 5. BOTÕES DE SCRIPTS (Formato Painel)
-- ==========================================
local yPos = 10

local function CriarBotao(icon, nome, categoria, url)
    local Panel = Instance.new("Frame")
    Panel.Size = UDim2.new(1, -10, 0, 50)
    Panel.Position = UDim2.new(0, 5, 0, yPos)
    Panel.BackgroundColor3 = CorPainel
    Panel.BorderSizePixel = 0
    Panel.Parent = ScrollingFrame
    
    local PanelCorner = Instance.new("UICorner")
    PanelCorner.CornerRadius = UDim.new(0, 8)
    PanelCorner.Parent = Panel
    
    local PanelStroke = Instance.new("UIStroke")
    PanelStroke.Thickness = 1
    PanelStroke.Color = Color3.fromRGB(30, 30, 35)
    PanelStroke.Parent = Panel
    
    local IconFrame = Instance.new("Frame")
    IconFrame.Size = UDim2.new(0, 32, 0, 32)
    IconFrame.Position = UDim2.new(0, 5, 0, 9)
    IconFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    IconFrame.BorderSizePixel = 0
    IconFrame.Parent = Panel
    
    local IconCorner = Instance.new("UICorner")
    IconCorner.CornerRadius = UDim.new(1, 0)
    IconCorner.Parent = IconFrame
    
    local Icon = Instance.new("TextLabel")
    Icon.Size = UDim2.new(1, 0, 1, 0)
    Icon.Text = icon
    Icon.TextSize = 16
    Icon.BackgroundTransparency = 1
    Icon.Parent = IconFrame
    
    local Nome = Instance.new("TextLabel")
    Nome.Size = UDim2.new(1, -60, 0, 20)
    Nome.Position = UDim2.new(0, 45, 0, 5)
    Nome.Text = nome
    Nome.TextColor3 = CorTexto
    Nome.TextSize = 13
    Nome.Font = Enum.Font.GothamBold
    Nome.BackgroundTransparency = 1
    Nome.Parent = Panel
    
    local CategoriaText = Instance.new("TextLabel")
    CategoriaText.Size = UDim2.new(1, -60, 0, 12)
    CategoriaText.Position = UDim2.new(0, 45, 0, 25)
    CategoriaText.Text = categoria
    CategoriaText.TextColor3 = CorCinza
    CategoriaText.TextSize = 9
    CategoriaText.Font = Enum.Font.Gotham
    CategoriaText.BackgroundTransparency = 1
    CategoriaText.Parent = Panel
    
    local ActionBtn = Instance.new("TextButton")
    ActionBtn.Size = UDim2.new(0, 25, 0, 25)
    ActionBtn.Position = UDim2.new(1, -32, 0, 12)
    ActionBtn.Text = "▶"
    ActionBtn.TextColor3 = CorBorda
    ActionBtn.TextSize = 12
    ActionBtn.Font = Enum.Font.GothamBold
    ActionBtn.BackgroundTransparency = 1
    ActionBtn.Parent = Panel
    
    ActionBtn.MouseButton1Click:Connect(function()
        ActionBtn.Text = "✔"
        ActionBtn.TextColor3 = Color3.fromRGB(0, 255, 100)
        
        local success, err = pcall(function()
            loadstring(game:HttpGet(url))()
        end)
        
        if success then
            print("✅ " .. nome .. " executado!")
        else
            print("❌ Erro: " .. tostring(err))
        end
        
        task.wait(1)
        ActionBtn.Text = "▶"
    end)
    
    yPos = yPos + 58
end

